<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:contentDescription="更换壁纸">
<FrameLayout android:id="@+id/widget_button" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/widget_icon_tile">
<ImageView android:id="@+id/widget_refresh" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/widget_refresh_blue" android:importantForAccessibility="no"/>
<ProgressBar android:id="@+id/widget_spinner" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:visibility="gone" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/widget_spinner" android:indeterminateDuration="900" android:interpolator="@android:anim/linear_interpolator" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="换壁纸" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" android:shadowColor="#80000000" android:shadowRadius="2" android:shadowDy="1"/>
</LinearLayout>
