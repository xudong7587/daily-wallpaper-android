            </intent-filter>
        </receiver>
        <service android:name=".WallpaperJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".WidgetChangeService" android:foregroundServiceType="dataSync" android:exported="false" />
        <receiver android:name=".WallpaperWidget$OneByOne" android:label="换壁纸 1×1" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_1x1" />
        </receiver>
        <receiver android:name=".WallpaperWidget$OneByTwo" android:label="换壁纸 1×2" android:exported="false">
